# ─── Procore OAuth (Developer Portal → tu app → OAuth Credentials) ───
# Usa las credenciales de Sandbox con las URLs de sandbox y las de Producción con las de producción.
PROCORE_CLIENT_ID=
# NUNCA se expone al frontend: solo lo leen las funciones serverless de /api.
PROCORE_CLIENT_SECRET=

# API y web de Procore
#   Sandbox:    https://sandbox.procore.com
#   Producción: https://api.procore.com
PROCORE_BASE_URL=https://sandbox.procore.com
# Servidor de autenticación (opcional; se deduce de PROCORE_BASE_URL si se omite)
#   Sandbox:    https://login-sandbox.procore.com
#   Producción: https://login.procore.com
PROCORE_LOGIN_URL=https://login-sandbox.procore.com

# Debe coincidir EXACTAMENTE con la Redirect URI registrada en el Developer Portal.
PROCORE_REDIRECT_URI=http://localhost:5173/api/auth/callback

# Secreto compartido del webhook. Configúralo en Procore como cabecera de destino:
#   Authorization: Bearer <WEBHOOK_SECRET>
WEBHOOK_SECRET=

# Clave para cifrar la sesión (AES-256-GCM). Mínimo 32 caracteres aleatorios.
#   Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# true → no se llama a Procore: se muestran en consola y en la UI los payloads que se enviarían.
DRY_RUN=true
